<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/welcome_text"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_selector"
        android:hint="@string/welcome_text"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="80"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/wifi_label"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/tile_selector"
            android:hint="@string/wifi_label"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="50"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/location_label"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/tile_selector"
            android:hint="@string/location_label"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="50"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/show_location"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="@color/focus_blue"
            android:focusable="true"
            android:text="@string/show_location"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <CheckBox
            android:id="@+id/show_vpn_status"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="@color/focus_blue"
            android:focusable="true"
            android:text="@string/show_vpn_status"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <CheckBox
            android:id="@+id/show_system_stats"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="@color/focus_blue"
            android:focusable="true"
            android:text="@string/show_system_stats"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/favorite_apps"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/available_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/open_android_settings"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/tile_selector"
            android:paddingHorizontal="20dp"
            android:text="@string/open_android_settings"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/tile_selector"
            android:paddingHorizontal="28dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
